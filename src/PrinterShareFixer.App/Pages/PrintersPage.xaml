<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PrinterShareFixer.App.Pages.PrintersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,4,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock
                Text="本机信息与打印机共享状态"
                Style="{StaticResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <ProgressRing x:Name="RefreshRing" Width="18" Height="18" IsActive="False" />
            <Button x:Name="RefreshButton" Content="刷新" Click="OnRefreshClick" />
            <Button x:Name="OpenPrintersButton" Content="打开打印机设置" Click="OnOpenPrintersClick" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Spacing="12">

                <!-- 本机信息 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="这台电脑" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="计算机名" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MachineNameText" Grid.Row="0" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="当前用户" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UserText" Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv4 地址" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="IpText" Grid.Row="2" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock
                            Text="网卡"
                            FontWeight="SemiBold"
                            Margin="0,4,0,0" />
                        <ItemsControl x:Name="AdapterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding AdapterName}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding IPv4}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Mac}"
                                            IsTextSelectionEnabled="True"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding SpeedText}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 打印机列表 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PrinterSummaryText" Text="本机打印机" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="PrinterHintText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="“未共享”的打印机需要在“打印机属性 → 共享”里勾选共享后，别的电脑才能连上；如果要开放共享，请到“修复打印机共享”页面执行一次修复。" />

                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="打印机名称" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="共享状态" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="驱动" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="端口" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl x:Name="PrinterList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="{Binding ShareGlyph}" Foreground="{Binding ShareBrush}" />
                                            <TextBlock Text="{Binding ShareText}" TextWrapping="Wrap" Foreground="{Binding ShareBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding DriverName}"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding PortText}"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding StatusText}"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
