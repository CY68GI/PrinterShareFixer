<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PrinterShareFixer.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,4,24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Left">

            <!-- 版本信息 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AppIcon" Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="打印机共享修复工具" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="EnvironmentText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 更新 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="UpdateStatusText"
                        TextWrapping="Wrap"
                        Text="点击「检查更新」从 GitHub 获取最新版本。" />
                    <TextBlock
                        x:Name="UpdateNotesText"
                        Visibility="Collapsed"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100" Value="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdateClick" />
                        <Button
                            x:Name="ApplyUpdateButton"
                            Content="立即更新并重启"
                            Visibility="Collapsed"
                            Click="OnApplyUpdateClick" />
                        <Button x:Name="OpenDownloadPageButton" Content="打开下载页" Click="OnOpenDownloadPageClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 更新内容 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="更新内容" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl x:Name="ChangelogList" />
                </StackPanel>
            </Border>

            <!-- 日志与备份 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="日志与备份" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="PathsText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开日志目录" Click="OnOpenLogFolderClick" />
                        <Button Content="打开备份目录" Click="OnOpenBackupFolderClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
